{
  "buildCommand": "remix vite:build",
  "devCommand": "remix vite:dev",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "build/client",
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
